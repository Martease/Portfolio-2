# Core
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio2

# Authentication hardening
ADMIN_REGISTRATION_CODE=replace-with-admin-registration-code
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# Capability links
CAPABILITY_TOKEN_PEPPER=replace-with-a-separate-random-secret-at-least-32-characters-long

# Contact / email
CONTACT_EMAIL=the_dev_op@outlook.com
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password

# Stripe
STRIPE_API_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-webhook-secret

# Google Workspace integration
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=replace-with-google-drive-root-folder-id
GOOGLE_DOCS_TEMPLATE_ID=replace-with-google-docs-template-id

# Cloudflare R2 signed copy storage
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_SIGNED_COPIES=replace-with-r2-private-bucket-name
R2_ENDPOINT=https://replace-account-id.r2.cloudflarestorage.com
R2_PRESIGNED_PUT_TTL_SECONDS=300
R2_PRESIGNED_GET_TTL_SECONDS=60
SIGNED_COPY_MAX_BYTES=26214400

# Optional seed users
SEED_ADMIN_EMAIL=admin@mamvolabs.com
SEED_ADMIN_PASSWORD=ChangeMe_Admin_123!
SEED_CLIENT_EMAIL=client@example.com
SEED_CLIENT_PASSWORD=secret
